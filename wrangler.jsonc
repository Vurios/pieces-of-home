{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pieces-of-home",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-10",
  "assets": {
    // The Vite plugin fills in the built client directory.
    "not_found_handling": "single-page-application",
    // Static asset requests are free and skip the Worker. Only these paths run it.
    "run_worker_first": ["/parties/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [
    // The Free plan only allows SQLite-backed Durable Objects.
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "observability": {
    "enabled": true
  }
}
