{
  "name": "pieces-of-home",
  "version": "0.1.0",
  "private": true,
  "description": "Pieces of Home: a cozy 1 to 4 player browser game about the machines left on the Moon and Mars. NASA Space Apps Challenge 2026.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:facts && vite build",
    "preview": "vite preview",
    "typecheck": "wrangler types && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node scripts/vitest.mjs run",
    "e2e": "playwright test",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "check:facts": "tsx scripts/check-facts.ts",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy && npm run deploy:pages",
    "deploy:pages": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "perfect-freehand": "^1.2.3",
    "roughjs": "^4.6.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.68.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "axe-core": "^4.14.0",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
